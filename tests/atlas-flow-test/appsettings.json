{
  "Flowthru": {
    "Services": {
      "Ollama": {
        "Endpoint": "https://ollama.speen.us",
        "DefaultModel": "qwen3:4b",
        "TimeoutSeconds": 120
      }
    },
    "Flows": {
      "CardProcessing": {
        "FilterOptions": {
          "Format": "commander",
          "Colors": null,
          "ColorIdentity": null,
          "Types": null,
          "Rarities": null,
          "Sets": null,
          "MinCmc": null,
          "MaxCmc": null,
          "ExcludeDigital": true,
          "ExcludePromo": true,
          "ExcludeUnreleased": false
        }
      },
      "FineTune": {
        "DefaultRepoId": "nomic-ai/nomic-embed-text-v1.5",
        "DefaultVariant": "default-nomic-embed-text-v1-5",
        "FineTuneBaseRepoId": "nomic-ai/nomic-embed-text-v1.5",
        "FineTuneVariant": "mtg-nomic-v1",
        "TrainNumEpochs": 2,
        "TrainPerDeviceBatchSize": 4,
        "TrainWarmupRatio": 0.1,
        "TrainLearningRate": 2e-5,
        "TrainLoggingSteps": 20,
        "TrainFp16": true,
        "TripletWeight": 1.5
      },
      "OracleEmbedding": {
        "EmbedBatchSize": 64,
        "Umap2DNNeighbors": 100,
        "Umap2DMinDist": 0.1,
        "UmapJitterSigma": 0.0001
      },
      "Clustering": {
        "Umap5DNNeighbors": 50,
        "Umap5DMinDist": 0.1,
        "Umap5DSupervised": true,
        "Umap5DSupervisionWeight": 0.7,
        "HdbscanMinClusterSize": 30,
        "HdbscanMinSamples": 5,
        "CTfIdfTopKeywords": 8,
        "CTfIdfLabelHead": 3,
        "CTfIdfNgramMin": 1,
        "CTfIdfNgramMax": 3,
        "CTfIdfMinDf": 2,
        "UmapJitterSigma": 0.0001
      },
      "Reporting": {
        "MaxAnnotations": 100,
        "AnnotationTextLimit": 36,
        "MarkerSize": 10,
        "MarkerOpacity": 0.7,
        "OracleHoverTruncateLimit": 500
      },
      "TagLabeling": {
        "ScryfallMinCardCount": 3,
        "TopKAffinity": 8,
        "MaxSampleLines": 6,
        "LabelerModel": "",
        "ExemplarBonus": 0.10,
        "AnchorFloor": 5,
        "LineAnchorThreshold": 0.5,
        "TopKInferences": 3
      }
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Flowthru": "Debug",
        "Microsoft": "Warning"
      }
    }
  }
}
