# Generated metadata
Metadata/

# 24h TTL cache for the Ingest flow's upstream GETs (Scryfall + Wizards). Written by
# FilesystemHttpCacheHandler — see tests/atlas-flow-test/FilesystemHttpCacheHandler.cs.
.http-cache/

# Ignore all generated data artifacts
Data/**

# Un-ignore layer directories and their Schemas subdirectories so git can traverse them
!Data/*/
!Data/*/Schemas/

# Allow curated raw input dataset files
!Data/_01_Raw/Datasets/Curated/**/*

# Allow all schema and catalog .cs files
!Data/**/*.cs

# Un-ignore all .gitkeep files anywhere
!**/.gitkeep

.flowthru
