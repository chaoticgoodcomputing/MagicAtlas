<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Hybrid project: Flowthru CLI host + NUnit test runner. dotnet run invokes Program.Main
         (the Flowthru CLI); dotnet test invokes the VSTest runner over NUnit [TestFixture]s. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MagicAtlas.Ast.Tests</RootNamespace>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>

    <!-- NUnit / VSTest configuration -->
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Flowthru host -->
    <PackageReference Include="Flowthru" Version="0.25.0" />
    <PackageReference Include="Flowthru.Cli" Version="0.25.0" />
    <!-- HTTP storage medium: lets the Commander Spellbook variants.json dump load as a plain
         https:// catalog item (FetchCombos), with conditional-GET caching under Datasets/External/.http-cache. -->
    <PackageReference Include="Flowthru.Extensions.Http" Version="0.25.0" />
    <!-- Python step host: the interaction-graph Plotly viz node (own .venv via pyproject.toml). -->
    <PackageReference Include="Flowthru.Extensions.Python" Version="0.25.0" />

    <!-- Hosting plumbing -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.*" />

    <!-- NUnit ratchet -->
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../libs/magic-ast/MagicAST.csproj" />
    <ProjectReference Include="../../libs/mast-query/MagicAST.Query.csproj" />
    <ProjectReference Include="../../libs/mast-interaction/MagicAST.Interaction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Python step sources + dep manifest (resolved via ModuleSearchPaths at the project root). -->
    <None Include="Flows\**\*.py" />
    <None Include="pyproject.toml" />
  </ItemGroup>

</Project>
