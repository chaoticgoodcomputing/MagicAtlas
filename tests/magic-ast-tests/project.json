{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "mast",
  "sourceRoot": "tests/magic-ast-tests",
  "projectType": "application",
  "tags": ["type:test", "scope:magic-ast"],
  "targets": {
    "build": {
      "//": "Build the consolidated MagicAST test harness (NUnit tests + Flowthru triage flow).",
      "executor": "nx:run-commands",
      "options": {
        "commands": ["dotnet build"],
        "cwd": "tests/magic-ast-tests",
        "parallel": false
      },
      "dependsOn": ["^build"]
    },
    "test": {
      "//": "Run the MagicAST NUnit suite. Every test must pass green; no ratchet tolerance.",
      "executor": "nx:run-commands",
      "options": {
        "commands": ["dotnet test"],
        "cwd": "tests/magic-ast-tests",
        "parallel": false
      }
    },
    "run": {
      "//": "Run the MagicAstTriage Flowthru flow over the corpus and emit Data/_08_Reporting/triage-report.json.",
      "executor": "nx:run-commands",
      "options": {
        "commands": ["dotnet run -- --flow MagicAstTriage"],
        "cwd": "tests/magic-ast-tests",
        "parallel": false
      }
    },
    "worktree-clean": {
      "//": "Reap MAST TDD-loop agent worktrees + merged agent branches (run after every batch). Default deletes only MERGED mast-tdd/* and worktree-agent-* branches; for a DISCARDED batch run `bash tools/clean-worktrees.sh --force` to also drop unmerged ones.",
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/clean-worktrees.sh",
        "cwd": "{workspaceRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet csharpier {projectRoot}",
        "cwd": "{workspaceRoot}"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet csharpier {projectRoot} --check",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
