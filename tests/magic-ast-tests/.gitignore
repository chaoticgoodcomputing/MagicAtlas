# Generated metadata
Metadata/

# Ignore all generated data artifacts
Data/**

# Un-ignore layer directories and their Schemas subdirectories so git can traverse them
!Data/*/
!Data/*/Schemas/
!Data/_01_Raw/Datasets/

# Allow raw input dataset files
!Data/_01_Raw/Datasets/Curated/**/*

# Hand-parsed test fixtures (driven by the mast-tdd-loop skill) and malformed
# corner cases that anchor the ratchet — the agent-facing source of truth.
!Data/HandParsedCards/**/*
!Data/MalformedParsedCards/**/*

# Keyword-expansion golds (ADR-0003 "sans examples" harness) — agent-facing source
# of truth, one per keyword.
!Data/KeywordExpansions/**/*

# Allow all schema and catalog .cs files
!Data/**/*.cs

# Un-ignore all .gitkeep files anywhere
!**/.gitkeep
