<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MagicAtlas</RootNamespace>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flowthru.Core" Version="0.28.0" />
    <PackageReference Include="Flowthru.Extensions.Parquet" Version="0.28.0" />
    <PackageReference Include="Flowthru.Extensions.Python" Version="0.28.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The promoted CardAtlas reporting flow parses oracle text (MagicAST) and reconstructs the
         port-graph interaction cycles (MagicAST.Interaction) that back the D1–D4 datasets. -->
    <ProjectReference Include="../magic-ast/MagicAST.csproj" />
    <ProjectReference Include="../mast-interaction/MagicAST.Interaction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="pyproject.toml" />
    <None Include="Flows/**/*.py" />
  </ItemGroup>

</Project>
