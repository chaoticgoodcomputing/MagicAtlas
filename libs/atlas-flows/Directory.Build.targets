<!--
  Override the repo-root CheckNxModuleBoundaries target — the hardcoded pnpm hash in the root
  Directory.Build.targets has drifted out of date with the current node_modules layout. Nx still
  enforces module boundaries via `nx build` / `nx affected` directly; the MSBuild target is the
  redundant path. Re-enable this when the root path is repaired or replaced with a pnpm-stable
  resolver.
-->
<Project>
  <Target Name="CheckNxModuleBoundaries" BeforeTargets="Build" />
</Project>
