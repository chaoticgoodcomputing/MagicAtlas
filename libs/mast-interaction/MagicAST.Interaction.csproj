<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MagicAST.Interaction</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- mast-interaction → mast-query → magic-ast schema export + the ObjectFilter relation
         operators (ADR-0001 / ADR-0008). The dependency is one-directional. -->
    <ProjectReference Include="../mast-query/MagicAST.Query.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0003 Stage 3 shadow gate: the test assembly compares PortFlowMatcher.Captures against
         the engine's internal FlowFeasible + guards (the "engine is oracle" equivalence proof). -->
    <InternalsVisibleTo Include="MagicAtlas.Ast.Tests" />
  </ItemGroup>

</Project>
